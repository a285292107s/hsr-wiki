  "traits": [
    {
      "id": 1008,
      "name": "狼狩",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/1008.png",
      "desc": "召唤【步离人】协同战斗，其在参与战斗后可以获得经验并升级。我方队员携带更多装备参与战斗会使其额外获得经验。\\n【狼狩】队员的前/后台强度提高，【步离人】每次升级后使该加成提高#2[i]%。"
    },
    {
      "id": 2002,
      "name": "击破",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/2002.png",
      "desc": "【击破】队员的前/后台强度提高，并在攻击处于弱点击破状态的敌方目标后造成超击破伤害。\\n敌方目标的初始韧性和韧性恢复量降低。"
    },
    {
      "id": 2005,
      "name": "治疗",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/2005.png",
      "desc": "我方小队的提高#1[i]%。【治疗】队员的提高。"
    }
  ],
