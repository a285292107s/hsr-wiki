","type_name":"战技","tag":"扩散","sp_base":30,"bp_need":1,"bp_add":null,"show_stance_list":[60,0,30],"skill_combo_value_delta":null,"extra":{},"level":{"1":{"level":1,"param_list":[1,1.5,0.75,10]},"2":{"level":2,"param_list":[1,1.65,0.825,10]},"3":{"level":3,"param_list":[1,1.8,0.9,10]},"4":{"level":4,"param_list":[1,1.95,0.975,10]},"5":{"level":5,"param_list":[1,2.1,1.05,10]},"6":{"level":6,"param_list":[1,2.25,1.125,10]},"7":{"level":7,"param_list":[1,2.4375,1.21875,10]},"8":{"level":8,"param_list":[1,2.625,1.3125,10]},"9":{"level":9,"param_list":[1,2.8125,1.40625,10]},"10":{"level":10,"param_list":[1,3,1.5,10]},"11":{"level":11,"param_list":[1,3.15,1.575,10]},"12":{"level":12,"param_list":[1,3.3,1.65,10]},"13":{"level":13,"param_list":[1,3.45,1.725,10]},"14":{"level":14,"param_list":[1,3.6,1.8,10]},"15":{"level":15,"param_list":[1,3.75,1.875,10]}}},"150503":{"id":150503,"name":"剑歌•神鬼无赦","desc":"对敌方全体造成等同于绯英<color=#f29e38ff><unbreak>#1[i]%</unbreak></color>攻击力的物理属性伤害，随后造成5次伤害，每次伤害对敌方随机单体造成等同于绯英<color=#f29e38ff><unbreak>#3[i]%</unbreak></color>攻击力的物理属性伤害。","simple_desc":"对敌方全体造成物理属性伤害，随后对敌方随机单体造成物理属性伤害，共弹射5次。","type":"Ultra","type_name":"终结技","tag":"群攻","sp_base":5,"bp_need":-1,"bp_add":null,"show_stance_list":[15,60,0],"skill_combo_value_delta":null,"extra":{},"level":{"1":{"level":1,"param_list":[0.8,5,0.72,88]},"2":{"level":2,"param_list":[0.88,5,0.768,88]},"3":{"level":3,"param_list":[0.96,5,0.816,88]},"4":{"level":4,"param_list":[1.04,5,0.864,88]},"5":{"level":5,"param_list":[1.12,5,0.912,88]},"6":{"level":6,"param_list":[1.2,5,0.96,88]},"7":{"level":7,"param_list":[1.3,5,1.02,88]},"8":{"level":8,"param_list":[1.4,5,1.08,88]},"9":{"level":9,"param_list":[1.5,5,1.14,88]},"10":{"level":10,"param_list":[1.6,5,1.2,88]},"11":{"level":11,"param_list":[1.68,5,1.248,88]},"12":{"level":12,"param_list":[1.76,5,1.296,88]},"13":{"level":13,"param_list":[1.84,5,1.344,88]},"14":{"level":14,"param_list":[1.92,5,1.392,88]},"15":{"level":15,"param_list":[2,5,1.44,88]}}},"150504":