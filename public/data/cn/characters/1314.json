unbreak>#3[i]</unbreak></color>点充能，发动1次<color=#f29e38ff><u>追加攻击</u></color>，对敌方全体造成量子属性伤害。\\n翡翠发动<color=#f29e38ff><u>追加攻击</u></color>时获得【当品】，使暴击伤害提高，最多叠加<color=#f29e38ff><unbreak>#2[i]</unbreak></color>层。","type":"Passive","type_name":"天赋","tag":"AoEAttack","sp_base":10,"bp_need":-1,"bp_add":0.5,"show_stance_list":[0,30,0],"skill_combo_value_delta":null,"extra":{},"level":{"1":{"level":1,"param_list":[0.012,50,8,5,0.6]},"2":{"level":2,"param_list":[0.0132,50,8,5,0.66]},"3":{"level":3,"param_list":[0.0144,50,8,5,0.72]},"4":{"level":4,"param_list":[0.0156,50,8,5,0.78]},"5":{"level":5,"param_list":[0.0168,50,8,5,0.84]},"6":{"level":6,"param_list":[0.018,50,8,5,0.9]},"7":{"level":7,"param_list":[0.0195,50,8,5,0.975]},"8":{"level":8,"param_list":[0.021,50,8,5,1.05]},"9":{"level":9,"param_list":[0.0225,50,8,5,1.125]},"10":{"level":10,"param_list":[0.024,50,8,5,1.2]},"11":{"level":11,"param_list":[0.0252,50,8,5,1.26]},"12":{"level":12,"param_list":[0.0264,50,8,5,1.32]},"13":{"level":13,"param_list":[0.0276,50,8,5,1.38]},"14":{"level":14,"param_list":[0.0288,50,8,5,1.44]},"15":{"level":15,"param_list":[0.03,50,8,5,1.5]}}},"131406":{"id":131406,"name":"攻击","desc":"攻击敌人，进入战斗后削弱敌方目标对应属性韧性。","simple_desc":"","type":"Maze","type_name":"","tag":"MazeAttack","sp_base":null,"bp_need":-1,"bp_add":0.5,"show_stance_list":[30,0,0],"skill_combo_value_delta":null,"extra":{},"level":{"1":{"level":1,"param_list":[]}}},"131407":{"id":131407,"name":"猎手的视界","desc":"使用秘技后使一定区域内的敌人陷入<unbreak>#1[i]</unbreak>秒【盲从】。【盲从】状态下敌人不会主动攻击我方目标。主动攻击陷入【盲从】的敌人进入战斗时，使所有处于【盲从】状态的敌人同时进入战斗。进入战斗后对敌方全体造成等同于翡翠<unbreak>#2[i]%</unbreak>攻击力的量子属性伤害，立即获得<unbreak>#3[i]</unbreak>层【当品】。","simple_desc":"使一定区域内敌人陷入【盲从】状态。攻击陷入【盲从】状态敌人，使所有处于【盲从】状态的敌人同时进入战斗，进入战斗后对敌方全体造成少量量子属性伤害，立即获得<color=#f29e38ff><unbreak>#3[i]</unbreak></color>层【当品】。","type":"Maze","type_name":"秘技","tag":"Impair","sp_base":null,"bp_need":-1,"bp_add":0.5,"show_stance_list":[0,0,0],"skill_combo_value_delta":null,"extra":{},"level":{"1":{"level":1,"param_list":[