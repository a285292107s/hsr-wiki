    {
      "id": 1001,
      "name": "列车同行",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/1001.png",
      "desc": "召唤【星穹列车】撞击敌方全体目标，并在场上留下【光轨】，使我方小队的前/后台强度提高。"
    },
    {
      "id": 2004,
      "name": "能量",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/2004.png",
      "desc": "【能量】队员的提高。在场上生成【能量地块】，可提供和能量恢复。"
    },
    {
      "id": 2012,
      "name": "欢愉",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/2012.png",
      "desc": "【欢愉】队员的提高。\\n备战阶段召唤【阿哈】为小队提供增益，【阿哈】拥有初始属性并穿戴3件随机简易装备，可将物品栏中简易装备拖拽给阿哈，与阿哈装备栏中的简易装备依次合成对应进阶装备。合成进阶装备后，本局该栏位将会被固定，无法合成其它进阶装备。"
    }
  ],
