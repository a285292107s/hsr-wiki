  "traits": [
    {
      "id": 1002,
      "name": "星核猎手",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/1002.png",
      "desc": "装备最多的【星核猎手】成为【猎星人】，【星核猎手】会协助【猎星人】作战。\\n【星核猎手】的和提高。"
    },
    {
      "id": 2006,
      "name": "燃血",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/2006.png",
      "desc": "【燃血】队员的和提高。战斗开始时，激活会记录【燃血】队员消耗生命值并在行动时攻击敌方全体目标的【燃血角斗场】。\\n【燃血】队员无法获得护盾，受到护盾时会回复#4[i]%生命上限+#7[i]生命值。"
    },
    {
      "id": 2007,
      "name": "减益",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/2007.png",
      "desc": "【减益】队员的前/后台强度提高，行动时使敌方陷入负面效果时，为随机目标附加【离火】，使其造成的伤害降低，并且被攻击后受到额外真实伤害，单次行动内最多触发#1[i]次。"
    }
  ],
