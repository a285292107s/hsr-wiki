{"id":800304015,"name":"蚕食者之影","icon":"Monster_8003040","figure":"Monster_8003040","rank":"Elite","camp":"裂界造物","stance":300,"weak":["Fire","Thunder","Wind"],"resist":{"Physical":0.2,"Ice":0.2,"Quantum":0.2,"Imaginary":0.2},"intro":"由星核力量幻造而成的虚影，执行着令裂界不断扩张的意志。\\n智慧生命的欲求在裂界中投影形成的活体能量，犹如一颗沙砾在蚌壳中凝成了珠贝。然而驱动它的这股欲望早已扭曲，模糊不清。","stats":{"hp":930,"atk":18,"def":210,"speed":172},"skills":[{"id":800304002,"name":"流年金刺","tag":"单攻","type_desc":"技能","damage_type":"Imaginary","attack_type":"Normal","desc":"对指定我方单体造成虚数属性伤害。","param_list":[3]},{"id":800304003,"name":"流年谴罚","tag":"单攻","type_desc":"技能","damage_type":"Imaginary","attack_type":"Normal","desc":"对指定我方单体造成大量虚数属性伤害。","param_list":[5]},{"id":800304004,"name":"黄金年代的绸缪","tag":"蓄力","type_desc":"技能","damage_type":"","attack_type":"Normal","desc":"使自身进入蓄力状态并获得9层【追忆刻度】，下次行动施放【黄金年代的解放】。每次受到攻击后失去1层【追忆刻度】。","param_list":[]},{"id":800304005,"name":"黄金年代的解放","tag":"弹射","type_desc":"技能","damage_type":"Imaginary","attack_type":"Normal","desc":"连续对我方随机单体造成少量虚数属性伤害，造成伤害的次数与自身剩余【追忆刻度】层数一致。若没有【追忆刻度】则本技能施放失败。","param_list":[2.25]},{"id":800304006,"name":"流年盾纱","tag":"天赋","type_desc":"天赋","damage_type":"","attack_type":"Normal","desc":"自身受到的普攻、战技、终结技、追加攻击伤害小幅降低，并有小概率使受到蚕食者之影攻击的我方目标陷入禁锢状态。","param_list":[0.1,0.2,0.5]},{"id":800304007,"name":"黄金年代的解放","tag":"弹射","type_desc":"技能","damage_type":"","attack_type":"Normal","desc":"","param_list":[]}],"stat_ratio":{"hp":1.0,"atk":1.0,"def":1.0,"speed":1.0},"level_group":1,"drops":[{"world_level":null,"avatar_exp":150,"items":[{"id":2,"name":"信用点","icon":"icon/item/2.png"},{"id":111001,"name":"熄灭原核","icon":"icon/item/111001.png"},{"id":182007,"name":"同谐黏液","icon":"icon/item/182007.png"},{"id":183004,"name":"迷思绳结","icon":"icon/item/183004.png"}]},{"world_level":1,"avatar_exp":200,"items":[{"id":2,"name":"信用点","icon":"icon/item/2.png"},{"id":111001,"name":"熄灭原核","icon":"icon/item/111001.png"},{"id":111002,"name":"微光原核","icon":"icon/item/111002.png"},{"id":182007,"name":"同谐黏液","icon":"icon/item/182007.png