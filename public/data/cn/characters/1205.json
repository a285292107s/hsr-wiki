.288,0.72,0.1152,0.288,0.72,0.288,0.9]},"5":{"level":5,"param_list":[0.304,0.76,0.1216,0.304,0.76,0.304,0.9]},"6":{"level":6,"param_list":[0.32,0.8,0.128,0.32,0.8,0.32,0.9]},"7":{"level":7,"param_list":[0.34,0.85,0.13599999,0.34,0.85,0.34,0.9]},"8":{"level":8,"param_list":[0.36,0.9,0.144,0.36,0.9,0.36,0.9]},"9":{"level":9,"param_list":[0.38,0.95,0.152,0.38,0.95,0.38,0.9]},"10":{"level":10,"param_list":[0.4,1,0.16,0.4,1,0.4,0.9]},"11":{"level":11,"param_list":[0.416,1.04,0.1664,0.416,1.04,0.416,0.9]},"12":{"level":12,"param_list":[0.432,1.08,0.1728,0.432,1.08,0.432,0.9]},"13":{"level":13,"param_list":[0.448,1.12,0.1792,0.448,1.12,0.448,0.9]},"14":{"level":14,"param_list":[0.464,1.16,0.1856,0.464,1.16,0.464,0.9]},"15":{"level":15,"param_list":[0.48,1.2,0.192,0.48,1.2,0.48,0.9]}}},"120506":{"id":120506,"name":"攻击","desc":"攻击敌人，进入战斗后削弱敌方目标对应属性韧性。","simple_desc":"","type":"Maze","type_name":"","tag":"MazeAttack","sp_base":null,"bp_need":-1,"bp_add":0.5,"show_stance_list":[30,0,0],"skill_combo_value_delta":null,"extra":{},"level":{"1":{"level":1,"param_list":[]}}},"120507":{"id":120507,"name":"业途风","desc":"立即攻击敌人，进入战斗后消耗等同于刃生命上限<unbreak>#2[i]%</unbreak>的生命值，同时对敌方全体造成等同于刃生命上限<unbreak>#1[i]%</unbreak>的风属性伤害。\\n若当前生命值不足，施放秘技时刃的当前生命值降低至1点。","simple_desc":"攻击敌人，进战后消耗自身生命值，并对敌方全体造成风属性伤害。","type":"Maze","type_name":"秘技","tag":"MazeAttack","sp_base":null,"bp_need":-1,"bp_add":0.5,"show_stance_list":[60,0,0],"skill_combo_value_delta":null,"extra":{},"level":{"1":{"level":1,"param_list":[0.4,0.2]}}},"120502":{"id":120502,"name":"地狱变","desc":"消耗等同于刃生命上限<unbreak>#1[i]%</unbreak>的生命值，进入【地狱变】状态。\\n处于【地狱变】状态时无法施放战技，同时使自身造成的伤害提高<color=#f29e38ff><unbreak>#4[i]%</unbreak></color>，普攻【支离剑】强化为【无间剑树】，持续<unbreak>#2[i]</unbreak>回合。\\n若当前生命值不足，施放战技时刃的当前生命值降低至1点。\\n该战技无法恢复能量。施放该战技后，本回合不会结束。","simple_desc":"消耗自身生命值，<color=#f29e38ff>获得强化普攻</color>，且本回合不会结束。","type":"BPSkill","type_name":"战技","tag":"Enhance","sp_base":null,"bp_need":1,"bp_add":0.5,"show_stance_list":[0,0,0],"skill_combo_value_delta":