    {
      "id": 1007,
      "name": "仙舟",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/1007.png",
      "desc": "【仙舟】召唤【神君】，其行动时将攻击敌方全体目标。【仙舟】队员行动后为【神君】叠加攻击段数并使其行动提前。\\n【仙舟】队员的前/后台强度和提高。"
    },
    {
      "id": 1008,
      "name": "狼狩",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/1008.png",
      "desc": "召唤【步离人】协同战斗，其在参与战斗后可以获得经验并升级。我方队员携带更多装备参与战斗会使其额外获得经验。\\n【狼狩】队员的前/后台强度提高，【步离人】每次升级后使该加成提高#2[i]%。"
    },
    {
      "id": 2007,
      "name": "减益",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/2007.png",
      "desc": "【减益】队员的前/后台强度提高，行动时使敌方陷入负面效果时，为随机目标附加【离火】，使其造成的伤害降低，并且被攻击后受到额外真实伤害，单次行动内最多触发#1[i]次。"
    }
  ],
