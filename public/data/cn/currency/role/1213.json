  "traits": [
    {
      "id": 1001,
      "name": "列车同行",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/1001.png",
      "desc": "召唤【星穹列车】撞击敌方全体目标，并在场上留下【光轨】，使我方小队的前/后台强度提高。"
    },
    {
      "id": 1007,
      "name": "仙舟",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/1007.png",
      "desc": "【仙舟】召唤【神君】，其行动时将攻击敌方全体目标。【仙舟】队员行动后为【神君】叠加攻击段数并使其行动提前。\\n【仙舟】队员的前/后台强度和提高。"
    },
    {
      "id": 2011,
      "name": "战技点",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/2011.png",
      "desc": "我方战技点上限提高，我方小队获得，施放战技或普攻时获得，【战技点】队员获得双倍加成，持续至自身回合结束。【战技点】队员消耗战技点时，每个战技点进行1次抽奖，奖池效果可叠加。"
    }
  ],
