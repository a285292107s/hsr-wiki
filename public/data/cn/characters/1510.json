]}}},"151002":{"id":151002,"name":"升起领航的烽火","desc":"施放战技后立即恢复所有<u>助战技</u>使用次数，姬子•启行获得【领航旗语】，持续<unbreak>#2[i]</unbreak>回合，姬子•启行每回合开始时持续回合数减1。当姬子•启行拥有【领航旗语】时，我方全体造成的伤害提高<color=#f29e38ff><unbreak>#1[i]%</unbreak></color>，每个回合开始时，立即恢复1次<u>助战技</u>使用次数。","simple_desc":"施放战技后立即恢复所有<u>助战技</u>使用次数，姬子•启行获得【领航旗语】。当姬子•启行拥有【领航旗语】时，造成的伤害提高，每个回合开始时，立即恢复1次<u>助战技</u>使用次数。","type":"BPSkill","type_name":"战技","tag":"辅助","icon":"icon/skill/Avatar/1510/SkillIcon_1510_BP.png","sp_base":30,"sp_need":null,"bp_need":1,"bp_add":null,"show_stance_list":[0,0,0],"stance_damage_type":null,"stance_damage_display":null,"skill_need":null,"max_level":15,"rated_rank_id":null,"rated_skill_tree_id":null,"skill_combo_value_delta":null,"extra":{},"level":{"1":{"level":1,"param_list":[0.1,3]},"2":{"level":2,"param_list":[0.11,3]},"3":{"level":3,"param_list":[0.12,3]},"4":{"level":4,"param_list":[0.13,3]},"5":{"level":5,"param_list":[0.14,3]},"6":{"level":6,"param_list":[0.15,3]},"7":{"level":7,"param_list":[0.1625,3]},"8":{"level":8,"param_list":[0.175,3]},"9":{"level":9,"param_list":[0.1875,3]},"10":{"level":10,"param_list":[0.2,3]},"11":{"level":11,"param_list":[0.21,3]},"12":{"level":12,"param_list":[0.22,3]},"13":{"level":13,"param_list":[0.23,3]},"14":{"level":14,"param_list":[0.24,3]},"15":{"level":15,"param_list":[0.25,3]}}},"151003":{"id":151003,"name":"我们，亦是逐星的巨人","desc":"立即操控「拓星者」，「拓星者」拥有可对敌方发动6次的【超频粒子光束】或消耗<u>【源能】</u>发动的【轨道歼灭脉冲】，对指定敌方单体最多造成等同于姬子•启行<color=#f29e38ff><unbreak>#9[i]%</unbreak></color>攻击力的火属性伤害，对其他目标最多造成等同于姬子•启行<color=#f29e38ff><unbreak>#10[i]%</unbreak></color>攻击力的火属性伤害。\\n当【超频粒子光束】次数耗尽时，会自动发动【轨道歼灭脉冲】，随后发动最后一击，造成<unbreak>#6[i]</unbreak>次伤害，每次伤害对敌方随机单体造成等同于姬子•启行<color=#f29e38ff><unbreak>#7[i]%</unbreak></color>攻击力的火属性伤害。\\n施放【超频粒子光束】或【轨道歼灭脉冲】对场上所有敌方造成致命伤害或敌方无法被继续削减生命值时，会立即发动最后一击。","simple_desc":"终结技期间可对敌方全体发动【超频粒子光束】或【轨道歼灭脉冲】。最后对敌方<color=#f29e38ff><unbreak>#6[i]</unbreak></color>个随机单体造成火属性伤害。","type":"Ultra","type_name":"终结技","tag":"群攻","icon":"icon/skill/Avatar/1510/SkillIcon_1510_U