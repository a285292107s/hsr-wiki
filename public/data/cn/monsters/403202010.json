{"id":403202010,"name":"残破容器","icon":"Monster_4032020","figure":"Monster_4032020","rank":"MinionLv2","camp":"","stance":180,"weak":["Ice","Thunder","Quantum"],"resist":{"Physical":0.2,"Fire":0.2,"Wind":0.2,"Imaginary":0.2},"intro":"盗火行者以灾难之力创造的分身，皆是寄宿着破坏意志的祸端。","stats":{"hp":465,"atk":18,"def":210,"speed":0},"skills":[{"id":403202001,"name":"共祭•亡死的黑云","tag":"扩散","type_desc":"技能","damage_type":"","attack_type":"Normal","desc":"对指定我方单体及其相邻目标造成少量物理属性伤害。","param_list":[0.5,0.25]},{"id":403202002,"name":"共祭•将尽的命数","tag":"群攻","type_desc":"技能","damage_type":"","attack_type":"Normal","desc":"对我方全体造成少量物理属性伤害，被击中目标降低生命值的一部分转化为<u>【侵蚀】</u>。","param_list":[0.5],"extra_effects":[{"id":240320101,"name":"侵蚀","desc":"攻击后回复侵蚀部分的生命值，击中的目标数量越多，回复的生命值越高。受到伤害时，降低生命值的一部分转化为侵蚀。消耗生命值时，降低的生命值会全部转化为侵蚀。通过回复生命值的方式解除侵蚀时，使自身获得【焕新】效果。【焕新】：下次攻击造成的伤害提高。","param_list":[]}]},{"id":403202003,"name":"为我祷咏","tag":"天赋","type_desc":"天赋","damage_type":"","attack_type":"Normal","desc":"抵抗控制类负面状态。当【至黑之剑，盗火行者】再次施放【亡死的黑云】或【将尽的命数】时，若自身曾被该攻击召唤，则与【至黑之剑，盗火行者】一同发起攻击。随后被其吸收，回复转化为<u>【苦痛缠绕】</u>的生命值，并使其获得<u>【灾难之力】</u>。","param_list":[1,0.06],"extra_effects":[{"id":403401001,"name":"灾难之力","desc":"施放特定技能时，消耗【灾难之力】的所有层数追加攻击段数。","param_list":[]},{"id":403401002,"name":"苦痛缠绕","desc":"吸收【残破容器】后回复召唤该【残破容器】时消耗的生命值，【残破容器】被消灭后，无法再回复召唤该【残破容器】时消耗的生命值。","param_list":[]}]},{"id":403202004,"name":"为我设奠","tag":"天赋","type_desc":"天赋","damage_type":"","attack_type":"Normal","desc":"受到致命攻击后，若【至黑之剑，盗火行者】的<u>【灾难之力】</u>层数不为0，立即被其重新召唤，但会使【至黑之剑，盗火行者】失去1层<u>【灾难之力】</u>和一定比例的生命值。【至黑之剑，盗火行者】施放【莫因舍弃而哭泣】时，被其吸收，并回复转化为<u>【苦痛缠绕】</u>的生命值。","param_list":[1,0.02],"extra_effects":[{"id":403401001,"name":"灾难之力","desc":"施放特定技能时，消耗【灾难之力】的所有层数追加攻击段数。","param_list":[]},{"id":403401002,"name":"苦痛缠绕","desc":"吸收【残破容器】后回复召唤该【残破容器】时消耗的生命值，【残破容器】被消灭后，无法再回复召唤该【残破容器】时消耗的生命值。","param_list":[]}]}],"stance_modify":-60.0,"stat_ratio":{"hp":0.2,"atk":1.0,"def":1.0,"speed":1.0},"level_group":1,"elite_group":1,"drops":[{"world_level":null,"avatar_exp":36,"items":[{"id":2,"name