  "traits": [
    {
      "id": 1012,
      "name": "夜之半神",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/1012.png",
      "desc": "每个战斗阶段后生成【月光精华】，完胜后获得#1[i]倍【月光精华】。获得足够的【月光精华】后可以获取晶矿奖励。\\n【夜之半神】队员的前/后台强度提高。"
    },
    {
      "id": 2006,
      "name": "燃血",
      "activation_type": "GreaterEqualThan",
      "icon": "SpriteOutput/GridFight/TraitIcon/Icon/2006.png",
      "desc": "【燃血】队员的和提高。战斗开始时，激活会记录【燃血】队员消耗生命值并在行动时攻击敌方全体目标的【燃血角斗场】。\\n【燃血】队员无法获得护盾，受到护盾时会回复#4[i]%生命上限+#7[i]生命值。"
    }
  ],
  "stars": {
