]},"5":{"level":5,"param_list":[60,240,0.28,0.0028000004,3,0.0056]},"6":{"level":6,"param_list":[60,240,0.3,0.0029999998,3,0.0059999996]},"7":{"level":7,"param_list":[60,240,0.325,0.0032500003,3,0.0065]},"8":{"level":8,"param_list":[60,240,0.35,0.0035,3,0.0069999993]},"9":{"level":9,"param_list":[60,240,0.375,0.0037500006,3,0.0075]},"10":{"level":10,"param_list":[60,240,0.4,0.0039999997,3,0.007999999]},"11":{"level":11,"param_list":[60,240,0.42,0.0042,3,0.0084]},"12":{"level":12,"param_list":[60,240,0.44,0.0044,3,0.0088]},"13":{"level":13,"param_list":[60,240,0.46,0.0046,3,0.009199999]},"14":{"level":14,"param_list":[60,240,0.48,0.0048,3,0.0095999995]},"15":{"level":15,"param_list":[60,240,0.5,0.005,3,0.01]}}},"150606":{"id":150606,"name":"攻击","desc":"攻击敌人，进入战斗后削弱敌方目标对应属性韧性。","simple_desc":"","type":"Maze","type_name":"","tag":null,"sp_base":null,"bp_need":-1,"bp_add":null,"show_stance_list":[30,0,0],"skill_combo_value_delta":null,"extra":{},"level":{"1":{"level":1,"param_list":[]}}},"150607":{"id":150607,"name":"朋友，这才是T0级秘技","desc":"召唤【怪怪怪味豆】，再次使用则解除召唤。使用秘技不消耗秘技点，秘技点为0时解除召唤且无法使用秘技。\\n【怪怪怪味豆】会使一定范围内的普通敌人陷入恐惧状态，同时自动搜寻并攻击普通敌人，消耗1个秘技点立即将其消灭，不会进入战斗。\\n【怪怪怪味豆】在场时，进入战斗后每个波次开始时触发1次【怪怪怪味豆】对应的【<u>头号补给盲盒</u>】，本次造成的<u>欢愉伤害</u>固定计入<unbreak>#1[i]</unbreak>点【<u>好活当赏</u>】。","simple_desc":"召唤【怪怪怪味豆】，再次使用则解除召唤。使用时<color=#f29e38ff>不消耗秘技点</color>。\\n【怪怪怪味豆】会自动搜寻并攻击普通敌人，消耗1个秘技点<color=#f29e38ff>立即将其消灭，不会进入战斗</color>。\\n进入战斗后，每个波次开始时触发【怪怪怪味豆】对应的【头号补给盲盒】。","type":"Maze","type_name":"秘技","tag":"召唤","sp_base":null,"bp_need":-1,"bp_add":null,"show_stance_list":[0,0,0],"skill_combo_value_delta":null,"extra":{},"level":{"1":{"level":1,"param_list":[99]}}},"150620":{"id":150620,"name":"殿堂级操作回放","desc":"获得<unbreak>#1[i]</unbreak>点【隐藏分】。","simple_desc":"获得【隐藏分】。","type":"ElationDamage","type_name":"欢愉技","tag":"强化","sp_base":null,"bp_need":-1,"bp_add":null,"show_stance_list":[0,0,0],"skill_combo_value_delta":null,"extra":{},"level":{"1":{"level":1,"param_list":[15]},"2":{"level":2,"param_list":[15]},"3":{"level":3,"param_list":[15]},"4":{"level":4,"param_list":[15]},"5":{"level":5,"param_list":[15]},"6":{"level":6,"param_list":[15]},"7":{"level":7,"param_list":[15]},"8":{"level":8,"param_list":[15]},"9":{"level":9,"param_list":[15]},"10":{"level":10,"param_list":[15]},"11":{"level":11,"param_list":[15]},"12":{"level":12,"param_list":[15]},"13":{"level":13,"param_list":[15]},"14":{"level":14,"param_list":[15]},"15":{"level":15,"param_list":[15]}}},"150608":{"id":150608,"name":"奖励关：「狼尊时刻」","desc":"造成总计等同于「银狼LV.<unbreak>999</unbreak>」<color=#f29e38ff><unbreak>#1[i]%</unbreak></color>攻击力的虚数属性伤害，均分为<unbreak>#3[i]</unbreak>段伤害弹射至敌方随机单体。每弹射一定段数，暂停弹射并触发1次【<u>头号补给盲盒</u>】，总计可触发<unbreak>#5[i]</unbreak>次。\\n若对场上所有敌方造成了致命伤害则结束本次技能，当存在可攻击的敌方目标后获得1个<u>额外回合</u>并基于剩余弹射段数和【<u>头号补给盲盒</u>】次数再次施放。每回合首次触发该效果时，使自身所有<u>增益效果</u>延长1回合。\\n上述伤害全部结算后发动最后一击，造成等同于「银狼LV.<unbreak>999</unbreak>」<color=#f29e38ff><unbreak>#4[i]%</unbreak></color>攻击力的虚数属性伤害，由敌方全体均分。\\n强化普攻无法恢复战技点。每拥有<unbreak>#6[i]</unbreak>点【隐藏分】，强化普攻期间造成的伤害提高原伤害的<unbreak>#8[i]%</unbreak>，最多叠加<unbreak>#7[i]</unbreak>层。","simple_desc":"造成虚数属性伤害，共弹射大量次数，期间可触发<color=#f29e38ff><unbreak>#5[i]</unbreak></color>次【头号补给盲盒】。若<color=#f29e38ff>对所有敌方造成了致命伤害，保留剩余效果</color>对新入场的敌方目标继续施放。最后造成虚数属性伤害，由敌方全体均分。\\n【隐藏分】每达到一定点数，可额外提高强化普攻的伤害。","type":"Normal","type_name":"普攻","tag":"弹射","sp_base":null,"bp_need":-1,"bp_add":null,"show_stance_list":[30,30,0],"skill_combo_value_delta":null,"extra":{},"level":{"1":{"level":1,"param_list":[1.2,0,100,0.5,3,60,2,0.15]},"2":{"level":2,"param_list":[1.44,0,100,0.6,3,60,2,0.15]},"3":{"level":3,"param_list":[1.68,0,100,0.7,3,60,2,0.15]},"4":{"level":4,"param_list":[1.92,0,100,0.8,3,60,2,0.15]},"5":{"level":5,"param_list":[2.16,0,100,0.9,3,60,2,0.15]},"6":{"level":6,"param_list":[2.4,0,100,1,3,60,2,0.15]},"7":{"level":7,"param_list":[2.64,0,100,1.1,3,60,2,0.15]},"8":{"level":8,"param_list":[2.88,0,100,1.2,3,60,2,0.15]},"9":{"level":9,"param_list":[3.12,0,100,1.3,3,60,2,0.15]},"10":{"level":10,"param_list":[3.36,